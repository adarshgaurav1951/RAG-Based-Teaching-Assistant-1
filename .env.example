# ==============================================================================
# RAG AI Teaching Assistant Configuration
# ==============================================================================

# External LLM Provider (Backend only; never exposed to client or browser)
# Supports OpenAI, Gemini (via OpenAI-compatible base URL), Groq, Mistral, Ollama, etc.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Speech-to-Text (ASR) Configuration - CPU INT8
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=auto
WHISPER_CPU_THREADS=2

# Vector Embeddings
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384
EMBED_BATCH_SIZE=4

# RAG & Chunking Settings
CHUNK_SECONDS=75
TOP_K=5
RELEVANCE_THRESHOLD=0.35
COLLECTION=lectures

# Local Storage Paths
DATA_DIR=data
AUDIO_DIR=data/audio
TRANSCRIPT_DIR=data/transcripts
QDRANT_PATH=data/qdrant
SQLITE_PATH=data/app.db

